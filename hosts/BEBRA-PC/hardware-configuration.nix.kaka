{ config, lib, pkgs, modulesPath, ... }:

{
  imports = [ (modulesPath + "/installer/scan/not-detected.nix") ];

  # --- CPU microcode ---
  hardware.cpu.intel.updateMicrocode = true;

  # --- Initrd ---
  boot.initrd = {
    availableKernelModules = [ "xhci_pci" "ahci" "nvme" "usb_storage" "sd_mod" "usbhid" ];
    kernelModules = [ ];
  };
  boot.kernelModules = [ "kvm-intel" ];
  boot.extraModulePackages = [ ];

  # --- Filesystems ---
  # NOTE: Replace UUIDs with your actual values from `blkid`
  fileSystems."/" = {
    device = "/dev/disk/by-label/nixos";
    fsType = "btrfs";
    options = [ "subvol=@" "compress=zstd" "noatime" "ssd" "discard=async" ];
  };

  fileSystems."/home" = {
    device = "/dev/disk/by-label/nixos";
    fsType = "btrfs";
    options = [ "subvol=@home" "compress=zstd" "noatime" "ssd" "discard=async" ];
  };

  fileSystems."/nix" = {
    device = "/dev/disk/by-label/nixos";
    fsType = "btrfs";
    options = [ "subvol=@nix" "compress=zstd" "noatime" "ssd" "discard=async" ];
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-label/boot";
    fsType = "vfat";
    options = [ "fmask=0022" "dmask=0022" ];
  };

  # --- Swap (32GB) ---
  swapDevices = [{
    device = "/dev/disk/by-label/swap";
    # OR use a swapfile:
    # device = "/swapfile";
    # size = 32768; # MB
  }];

  # --- zram (fast in-memory compression, reduces swap I/O) ---
  zramSwap = {
    enable = true;
    memoryPercent = 25; # 8GB zram on 32GB RAM
  };

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
}
